# ══════════════════════════════════════════════════════
#  Auth & Session Security Analyzer — .env.example
#  Copier ce fichier en .env et remplir les valeurs
# ══════════════════════════════════════════════════════

# Environnement (development | production)
ENV=development

# Clé de sécurité interne (changer en production)
SECRET_KEY=your_secret_key_here_change_in_production

# Base de données SQLite
DATABASE_URL=sqlite:///./analyzer.db

# ── Google Gemini AI ──────────────────────────────────
# Obtenir une clé gratuite : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Modèles disponibles :
#   gemini-2.0-flash      → 1500 req/jour (recommandé)
#   gemini-2.0-flash-lite → backup automatique
#   gemini-1.5-flash      → fallback secondaire
GEMINI_MODEL=gemini-2.0-flash

# ── MobSF (optionnel) ─────────────────────────────────
# Lancer MobSF : docker run -it --rm -p 8008:8000 opensecurity/mobile-security-framework-mobsf
# MOBSF_URL=http://localhost:8008
# MOBSF_API_KEY=your_mobsf_api_key_here
