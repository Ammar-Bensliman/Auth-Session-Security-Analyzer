# ══════════════════════════════════════════════════════
#  Auth & Session Security Analyzer — .gitignore
# ══════════════════════════════════════════════════════

# ── Variables d'environnement sensibles ───────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
*.egg-info/
dist/
build/
*.egg
*.manifest
*.spec

# ── Node / Frontend ───────────────────────────────────
node_modules/
dist/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Données runtime (uploads, DB, vecteurs) ───────────
backend/data/
data/
*.db
*.sqlite
*.sqlite3
chroma_db/
uploads/
extracts/

# ── Docker volumes & cache ────────────────────────────
.docker/

# ── IDEs & OS ─────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ── Logs ──────────────────────────────────────────────
*.log
logs/

# ── Clés & certificats ────────────────────────────────
*.pem
*.key
*.cert
*.p12
*.pfx
secrets/
